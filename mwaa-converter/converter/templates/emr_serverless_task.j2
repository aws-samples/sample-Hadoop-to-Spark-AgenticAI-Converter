    # ── Task: {{ task_id }} ──────────────────────────────────────────────
    # Source Job: {{ source_job_id }} ({{ source_job_type }})
    # Script: {{ source_script }} → {{ target_script }}
    {{ task_id }} = EmrServerlessStartJobOperator(
        task_id="{{ task_id }}",
        application_id=Variable.get("{{ var_emr_app_id }}", default_var="__PLACEHOLDER__"),
        execution_role_arn=Variable.get("{{ var_emr_exec_role_arn }}", default_var="__PLACEHOLDER__"),
        job_driver={
            "sparkSubmit": {
                "entryPoint": f"{Variable.get('{{ var_scripts_bucket }}', default_var='__PLACEHOLDER__')}/{{ entry_point_path }}",
{% if entry_point_args %}
                "entryPointArguments": [
{% for arg in entry_point_args %}
                    {{ arg }},
{% endfor %}
                ],
{% endif %}
                "sparkSubmitParameters": "{{ spark_submit_parameters }}",
            }
        },
        configuration_overrides={
            "monitoringConfiguration": {
                "s3MonitoringConfiguration": {
                    "logUri": f"{Variable.get('{{ var_logs_bucket }}', default_var='__PLACEHOLDER__')}/{{ task_id }}/",
                }
            }
        },
        {% if aws_conn_id %}aws_conn_id="{{ aws_conn_id }}",{% endif %}
        {% if trigger_rule and trigger_rule != 'all_success' %}trigger_rule="{{ trigger_rule }}",{% endif %}
    )

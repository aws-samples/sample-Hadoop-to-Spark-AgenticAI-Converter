{% if has_external_sensors %}

def _latest_run_of(external_dag_id):
    """execution_date_fn for ExternalTaskSensor: the latest run of another DAG.

    Returns the logical date of the most recent run of external_dag_id that started
    before this run's data interval ended, so the sensor checks that run's task.
    """
    def _fn(logical_date, **context):
        from airflow.models import DagRun
        runs = DagRun.find(dag_id=external_dag_id,
                           execution_end_date=context["data_interval_end"])
        return max((r.execution_date for r in runs), default=logical_date)
    return _fn

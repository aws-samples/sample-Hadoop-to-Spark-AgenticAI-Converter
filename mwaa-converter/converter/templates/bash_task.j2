    # ── Task: {{ task_id }} ──────────────────────────────────────────────
    # Source Job: {{ source_job_id }} ({{ source_job_type }})
    # Source command: {{ source_command }}
    {{ task_id }} = BashOperator(
        task_id="{{ task_id }}",
        bash_command="{{ bash_command | replace('"', '\\"') }}",
        {% if env_vars %}
        env={
            {% for name, key in env_vars.items() %}
            "{{ name }}": "{{ '{{' }} var.value.get('{{ key }}', '') {{ '}}' }}",
            {% endfor %}
        },
        append_env=True,
        {% endif %}
        {% if trigger_rule and trigger_rule != 'all_success' %}trigger_rule="{{ trigger_rule }}",{% endif %}
    )
